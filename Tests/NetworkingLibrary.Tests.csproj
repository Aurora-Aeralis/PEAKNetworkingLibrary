<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0050;CS0067;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="HarmonyX" Version="2.7.0" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetworkingLibrary.csproj" />
  </ItemGroup>

  <Target Name="CopyBepInExRuntimeAssembliesForTests" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <BepInExTestRuntimeAssemblies Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'BepInEx.BaseLib' Or '%(ReferencePath.NuGetPackageId)' == 'HarmonyX' Or '%(ReferencePath.NuGetPackageId)' == 'MonoMod.RuntimeDetour' Or '%(ReferencePath.NuGetPackageId)' == 'MonoMod.Utils'" />
      <MonoCecilRuntimeRoot Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Mono.Cecil'" />
      <MonoCecilRuntimeAssemblies Include="%(MonoCecilRuntimeRoot.RootDir)%(MonoCecilRuntimeRoot.Directory)Mono.Cecil*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BepInExTestRuntimeAssemblies);@(MonoCecilRuntimeAssemblies)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
